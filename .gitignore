# ---- 依赖（本项目零依赖，此目录一般不存在）----
node_modules/

# ---- 运行时数据（含真实数据库、现场照片、导出文件、备份库）----
data/
certs/
logs/
*.log

# ---- 数据库兜底：即使哪天库被挪出 data/（手工复制、导出到根目录等）也不入库 ----
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlitedb
*.regressbak

# ---- 密钥 / 凭据（切勿入库）----
key.txt
*.key
*.pem
admin-password.txt

# ---- 本地临时文件与一次性脚本 ----
tests/_tmp-*.js
scripts/_sleep.cmd

# ---- 本地工作台与设计草稿 ----
.workbuddy/
_redesign-preview/
_redesign-preview.html
_mobile-redesign.html

# ---- 本地快照备份目录 / 工作草稿 ----
_backup-*/
__patch/
_patch/

# ---- 内部运维资料（含真实网络参数，只在本机用，不进公开仓库）----
# 为什么整份排除而不是脱敏：这几份就是「这台机器怎么配网络」的操作说明，
# 把地址换成占位符后对任何人都没用了。手册里已改成通用表述。
docs/网络与静态IP.md
scripts/net-static.ps1
scripts/net-dhcp.ps1

# ---- 本机生成的同步入口（内含 bash.exe 绝对路径，由 install-repo-sync.ps1 生成）----
scripts/repo-sync-run.cmd

# ---- 手工备份副本（版本管理交给 git，这些不入库）----
*.bak
*.bak[0-9]*
*.bak-*
*.orig
*.old

# ---- 操作系统噪音 ----
.DS_Store
Thumbs.db
desktop.ini
